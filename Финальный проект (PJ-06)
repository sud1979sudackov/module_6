// pages/Results.tsx
import React, { useState, useEffect } from 'react';
import { useLocation } from 'react-router-dom';
import { useGetDocumentsMutation } from '../store/api/searchApi';
import SearchResults from '../components/Search/SearchResults';
import Loader from '../components/UI/Loader';

const Results: React.FC = () => {
  const location = useLocation();
  const [getDocuments, { isLoading }] = useGetDocumentsMutation();
  const [documents, setDocuments] = useState<any[]>([]);
  const [currentPage, setCurrentPage] = useState(1);

  const { histograms, objectIds } = location.state || {};
  const itemsPerPage = 10;

  useEffect(() => {
    loadDocuments();
  }, [currentPage]);

  const loadDocuments = async () => {
    if (!objectIds) return;

    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;
    const idsToLoad = objectIds.slice(startIndex, endIndex);

    try {
      const response = await getDocuments(idsToLoad).unwrap();
      setDocuments(prev => [...prev, ...response]);
    } catch (error) {
      console.error('Error loading documents:', error);
    }
  };

  const handleLoadMore = () => {
    setCurrentPage(prev => prev + 1);
  };

  const hasMore = objectIds && documents.length < objectIds.length;

  return (
    <div className="results-page">
      <h1>Результаты поиска</h1>
      
      {histograms && (
        <div className="summary">
          <h3>Сводная информация</h3>
          <p>Найдено публикаций: {objectIds?.length || 0}</p>
          {/* Отображение гистограмм */}
        </div>
      )}

      <SearchResults documents={documents} />
      
      {isLoading && <Loader />}
      
      {hasMore && !isLoading && (
        <button onClick={handleLoadMore} className="load-more-btn">
          Показать еще
        </button>
      )}
    </div>
  );
};

export default Results;
