// pages/Search.tsx
import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAppDispatch } from '../store';
import { useSearchHistogramsMutation, useSearchObjectsMutation } from '../store/api/searchApi';
import SearchForm from '../components/Search/SearchForm';
import Loader from '../components/UI/Loader';
import Notification from '../components/UI/Notification';

const Search: React.FC = () => {
  const navigate = useNavigate();
  const dispatch = useAppDispatch();
  const [searchHistograms, { isLoading: histogramsLoading }] = useSearchHistogramsMutation();
  const [searchObjects, { isLoading: objectsLoading }] = useSearchObjectsMutation();
  const [error, setError] = useState<string>('');

  const handleSearch = async (searchParams: any) => {
    try {
      setError('');
      
      // Запрос гистограмм и объектов параллельно
      const [histogramsResponse, objectsResponse] = await Promise.all([
        searchHistograms(searchParams).unwrap(),
        searchObjects(searchParams).unwrap()
      ]);

      // Сохраняем результаты в store и переходим к результатам
      navigate('/results', { 
        state: { 
          histograms: histogramsResponse, 
          objectIds: objectsResponse.items 
        } 
      });
      
    } catch (err: any) {
      setError(err.message || 'Ошибка поиска');
    }
  };

  return (
    <div className="search-page">
      <h1>Поиск публикаций</h1>
      <SearchForm onSubmit={handleSearch} />
      
      {(histogramsLoading || objectsLoading) && <Loader />}
      {error && <Notification message={error} type="error" />}
    </div>
  );
};

export default Search;
